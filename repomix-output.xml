  width: var(--activitybar-w);
  flex: 0 0 auto;
  background: var(--bg-panel);
  border-right: 1px solid var(--border-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 0;
  gap: 22px;
}
.activitybar__btn {
  background: none;
  border: none;
  color: var(--text-muted);
  padding: 4px;
  border-radius: var(--radius-sm);
  display: flex;
}
.activitybar__btn:hover { color: var(--text-secondary); }
.activitybar__btn--active { color: var(--text-primary); position: relative; }
.activitybar__btn--active::before {
  content: "";
  position: absolute;
  left: -14px;
  top: 2px;
  bottom: 2px;
  width: 2px;
  background: var(--cyan);
  border-radius: 2px;
}
.activitybar__spacer { flex: 1; }

/* sidebar */
.sidebar {
  width: var(--sidebar-w);
  flex: 0 0 auto;
  background: var(--bg-panel);
  border-right: 1px solid var(--border-soft);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.sidebar__header {
  font-family: var(--font-mono);
  font-weight: 600;
  font-size: 11px;
  letter-spacing: 0.15em;
  color: var(--text-muted);
  padding: 16px 24px 12px;
}
.sidebar__list { flex: 1; overflow-y: auto; padding-bottom: 12px; }
.sidebar__item {
  display: flex;
  align-items: center;
  gap: 22px;
  width: 100%;
  text-align: left;
  padding: 6px 24px;
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
  background: none;
  border: none;
  border-left: 2px solid transparent;
}
.sidebar__item:hover { background: var(--bg-hover); color: var(--text-primary); }
.sidebar__item--active {
  background: var(--bg-elevated);
  color: var(--text-primary);
  font-weight: 600;
  border-left-color: var(--blue);
}
.sidebar__icon { flex: 0 0 auto; display: flex; }
.sidebar__label { flex: 1; text-align: center; margin-right: 37px; }
.sidebar__copilot {
  margin: 10px 16px;
  padding: 9px 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: rgba(183, 148, 246, 0.08);
  border-color: rgba(183, 148, 246, 0.3);
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-weight: 600;
  font-size: 12px;
  color: var(--purple);
}
.sidebar__copilot-badge {
  margin-left: auto;
  font-size: 10px;
  background: rgba(183, 148, 246, 0.15);
  padding: 2px 6px;
  border-radius: 4px;
}
.sidebar__settings {
  padding: 10px 16px 14px;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  border-top: 1px solid var(--border-soft);
}

/* mobile sidebar becomes an overlay drawer */
.sidebar__overlay { display: none; }
@media (max-width: 780px) {
  .sidebar {
    position: absolute;
    left: calc(-1 * var(--activitybar-w));
    top: 0;
    bottom: 0;
    z-index: 30;
    transform: translateX(-100%);
    transition: transform 0.2s ease;
    box-shadow: 20px 0 40px rgba(0,0,0,0.4);
  }
  .sidebar--open { transform: translateX(0); }
  .sidebar__overlay {
    display: block;
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 20;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .sidebar__overlay--visible { opacity: 1; pointer-events: auto; }
}

/* main column */
.ide__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  position: relative;
  overflow: hidden;
}

/* tab bar */
.tabbar {
  height: var(--tabbar-h);
  flex: 0 0 auto;
  display: flex;
  background: var(--bg-panel);
  border-bottom: 1px solid var(--border-soft);
  overflow-x: auto;
}
.tab {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 14px;
  font-size: 12.5px;
  color: var(--text-muted);
  border-right: 1px solid var(--border-soft);
  background: transparent;
  white-space: nowrap;
  flex: 0 0 auto;
}
.tab:hover { color: var(--text-secondary); background: var(--bg-hover); }
.tab--active {
  color: var(--text-primary);
  background: var(--bg-elevated);
  box-shadow: inset 0 -2px 0 var(--cyan);
}
.tab__close-btn { color: var(--text-muted); display: none; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 0; }
.tab:hover .tab__close-btn { display: flex; opacity: 0.6; }
.tab__close-btn:hover { opacity: 1 !important; background: var(--bg-chrome); color: var(--text-primary); }

/* breadcrumb */
.breadcrumb {
  height: var(--breadcrumb-h);
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 18px;
  font-size: 11.5px;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border-soft);
  overflow-x: auto;
  white-space: nowrap;
}
.breadcrumb span:last-child { color: var(--text-secondary); }

/* content area */
.content {
  flex: 1;
  overflow-y: auto;
  padding: 44px 56px 90px;
}
@media (max-width: 900px) { .content { padding: 34px 30px 80px; } }
@media (max-width: 560px) { .content { padding: 26px 18px 70px; } }

/* status bar */
.statusbar {
  height: var(--statusbar-h);
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
  background: var(--cyan);
  color: #ffffff;
  font-size: 11.5px;
  font-weight: 600;
  gap: 12px;
}
.statusbar__side { display: flex; align-items: center; gap: 14px; overflow: hidden; }
.statusbar__item { display: flex; align-items: center; gap: 5px; white-space: nowrap; }
@media (max-width: 700px) { .statusbar__hide-sm { display: none; } }
@media (max-width: 480px) { .statusbar__hide-xs { display: none; } }

/* ───────────────────────────── page content ───────────────────────────── */
.page { max-width: 1040px; margin: 0 auto; animation: fadein 0.25s ease; }
@keyframes fadein { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

.comment { color: var(--comment); font-family: var(--font-mono); font-size: 15px; font-weight: 500; font-style: italic; display: block; margin-bottom: 20px; }
.comment--block { margin-bottom: 28px; }

.page-title {
  font-size: clamp(32px, 6vw, 52px);
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  letter-spacing: -0.01em;
  margin-bottom: 6px;
}

.hero__name {
  font-family: 'Syne', sans-serif;
  font-size: clamp(48px, 10vw, 84px);
  font-weight: 800;
  line-height: 0.85;
  letter-spacing: -0.04em;
  margin-bottom: 12px;
  word-break: break-word;
  text-transform: capitalize;
}
.hero__firstname {
  color: #ffffff;
}
.hero__lastname {
  color: #f472b6;
}
.hero__underline {
  height: 3px;
  width: 120px;
  max-width: 40%;
  background: var(--border-soft);
  border-radius: 2px;
  margin: 24px 0 32px;
}

.badge-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 26px; }
.badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 14px;
  border-radius: 0;
  border: 1px solid var(--border);
  background: var(--bg-card);
  font-family: var(--font-mono);
  font-size: 12.5px;
  color: var(--text-secondary);
}
.badge__dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 auto; }
.badge--accent {
  border-color: rgba(244, 114, 182, 0.4);
  color: var(--pink);
  background: rgba(244, 114, 182, 0.08);
}

.lede { font-family: var(--font-mono); font-size: 15px; line-height: 1.8; color: var(--text-secondary); max-width: 680px; margin-bottom: 34px; }
.lede strong { color: var(--cyan); font-weight: 600; }
.lede .hl-pink { color: var(--pink); font-weight: 600; }

.btn-row { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 56px; }
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 11px 20px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: var(--bg-card);
  font-size: 13.5px;
  color: var(--text-primary);
  transition: transform 0.12s ease, border-color 0.12s ease, background 0.12s ease;
}
.btn:hover { transform: translateY(-1px); border-color: #34343e; background: var(--bg-elevated); }
.btn--primary { background: var(--cyan); color: #ffffff; border-color: var(--cyan); font-weight: 600; }
.btn--primary:hover { background: #005a9e; }

.stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border-soft); border: 1px solid var(--border-soft); border-radius: var(--radius-md); overflow: hidden; margin-bottom: 50px; }
.stat-card { background: var(--bg-panel); padding: 26px 18px; text-align: center; }
.stat-card__value { font-family: 'Syne', sans-serif; font-size: clamp(22px, 3.5vw, 28px); font-weight: 800; margin-bottom: 6px; color: var(--text-primary); }
.stat-card__label { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.15em; color: var(--text-muted); text-transform: uppercase; }
@media (max-width: 700px) { .stat-grid { grid-template-columns: repeat(2, 1fr); } }

.social-row { display: flex; flex-wrap: wrap; gap: 10px; }
.social-pill {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 11px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  font-size: 13px;
  color: var(--text-secondary);
}
.social-pill:hover { color: var(--text-primary); border-color: #34343e; background: var(--bg-elevated); }

/* about page */
.bio-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  padding: 30px 32px;
  font-size: 14.5px;
  line-height: 1.85;
  color: var(--text-secondary);
  margin-bottom: 36px;
  font-family: var(--font-mono);
}
.bio-card strong { color: var(--text-primary); }
.bio-card .hl-cyan { color: var(--cyan); font-weight: 600; }
.bio-card .hl-pink { color: var(--pink); font-weight: 600; }

.section-heading {
  font-size: 13px;
  letter-spacing: 0.14em;
  color: var(--cyan);
  margin-bottom: 18px;
  margin-top: 46px;
}

.focus-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  padding: 30px 32px;
}
.focus-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 40px; }
@media (max-width: 640px) { .focus-grid { grid-template-columns: 1fr; } }
.focus-item { display: flex; gap: 12px; font-size: 14px; color: var(--text-secondary); line-height: 1.6; }
.focus-item__icon { flex: 0 0 auto; }
.edu-list { display: flex; flex-direction: column; gap: 16px; }
.edu-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  padding: 24px 26px;
}
.edu-card__top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 4px; }
.edu-card__school { font-size: 17px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
.edu-card__period { font-size: 12.5px; color: var(--text-muted); white-space: nowrap; }
.edu-card__loc { font-size: 13px; color: var(--text-muted); margin-bottom: 10px; }
.edu-card__degree { color: var(--cyan); font-weight: 600; font-size: 14.5px; margin-bottom: 6px; }
.edu-card__notes { font-size: 13px; color: var(--text-secondary); line-height: 1.6; }

/* projects page */
.project-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
@media (max-width: 800px) { .project-grid { grid-template-columns: 1fr; } }

.project-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  padding: 26px;
  display: flex;
  flex-direction: column;
}
.project-card__top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; gap: 10px; }
.project-card__icon { font-size: 26px; line-height: 1; }
.project-card__links { display: flex; gap: 8px; flex-wrap: wrap; }
.pill-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 10px;
  font-size: 11.5px;
  border: 1px solid var(--border);
  border-radius: 999px;
  color: var(--text-secondary);
}
.pill-link:hover { color: var(--text-primary); border-color: #34343e; }
.pill-link--live { color: var(--cyan); border-color: rgba(94,234,212,0.35); }

.project-card__tags { font-size: 11px; letter-spacing: 0.06em; color: var(--purple); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.status-dot { display: inline-flex; align-items: center; gap: 5px; font-size: 10.5px; letter-spacing: 0.04em; padding: 2px 8px; border-radius: 0; border: 1px solid var(--border); }
.status-dot--shipped { color: var(--green); border-color: rgba(74,222,128,0.3); }
.status-dot--building { color: var(--orange); border-color: rgba(251,146,60,0.3); }
.status-dot i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; display: inline-block; }

.project-card__title { font-size: 21px; font-weight: 700; margin-bottom: 10px; }
.project-card__desc { font-size: 13.5px; line-height: 1.7; color: var(--text-secondary); flex: 1; margin-bottom: 18px; }
.tech-row { display: flex; flex-wrap: wrap; gap: 8px; }
.tech-chip { font-size: 11.5px; padding: 5px 10px; border-radius: 0; border: 1px solid var(--border); color: var(--text-secondary); background: var(--bg-elevated); }

/* skills page */
.skills-intro { font-size: 13.5px; color: var(--text-secondary); margin-bottom: 40px; }
.skills-intro .k { color: var(--pink); }
.skills-intro .v { color: var(--cyan); }
.skill-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px 60px; }
@media (max-width: 800px) { .skill-grid { grid-template-columns: 1fr; gap: 34px; } }
.skill-group__title {
  font-size: 12px;
  letter-spacing: 0.12em;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border-soft);
  padding-bottom: 12px;
  margin-bottom: 20px;
}
.skill-row { margin-bottom: 16px; }
.skill-row:last-child { margin-bottom: 0; }
.skill-row__top { display: flex; justify-content: space-between; font-size: 13.5px; margin-bottom: 7px; }
.skill-row__name { color: var(--text-primary); }
.skill-row__pct { color: var(--text-muted); font-size: 12px; }
.skill-bar { height: 5px; background: var(--bg-elevated); border-radius: 0; overflow: hidden; }
.skill-bar__fill { height: 100%; border-radius: 0; }

/* contact page */
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
@media (max-width: 800px) { .contact-grid { grid-template-columns: 1fr; gap: 40px; } }
.contact-link {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 18px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  margin-bottom: 12px;
}
.contact-link:hover { border-color: #34343e; background: var(--bg-elevated); }
.contact-link__icon {
  width: 38px; height: 38px; border-radius: var(--radius-sm);
  background: var(--bg-elevated);
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto;
  color: var(--cyan);
}
.contact-link__name { font-size: 11px; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 2px; }
.contact-link__value { font-size: 14px; color: var(--text-primary); word-break: break-word; }

.field { margin-bottom: 16px; }
.field__label { display: block; font-size: 12px; color: var(--text-secondary); margin-bottom: 7px; }
.field__label .req { color: var(--pink); }
.field__input, .field__textarea {
  width: 100%;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 11px 13px;
  font-family: var(--font-mono);
  font-size: 13.5px;
  color: var(--text-primary);
}
.field__input::placeholder, .field__textarea::placeholder { color: var(--text-muted); }
.field__input:focus, .field__textarea:focus { outline: none; border-color: var(--cyan); }
.field__textarea { resize: vertical; min-height: 110px; }
.send-btn {
  width: 100%;
  padding: 13px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--cyan);
  background: var(--cyan);
  color: #08080a;
  font-weight: 700;
  font-size: 13.5px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.send-btn:hover { background: #7ff2e2; }
.send-btn:disabled { opacity: 0.6; cursor: default; }
.form-note { font-size: 11.5px; color: var(--text-muted); margin-top: 10px; text-align: center; }
.form-status { font-size: 12.5px; margin-top: 10px; padding: 9px 12px; border-radius: var(--radius-sm); border: 1px solid; }
.form-status--ok { color: var(--green); border-color: rgba(74,222,128,0.3); background: rgba(74,222,128,0.06); }
.form-status--err { color: var(--red); border-color: rgba(248,113,113,0.3); background: rgba(248,113,113,0.06); }

/* readme page */
.readme-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  padding: 34px 36px;
}
.readme-card h1 { font-size: 30px; font-weight: 800; margin-bottom: 6px; }
.readme-card__sub { color: var(--text-muted); font-size: 13.5px; margin-bottom: 20px; }
.readme-card__badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 26px; }
.readme-badge { font-size: 11.5px; padding: 5px 11px; border-radius: 0; border: 1px solid var(--border); background: var(--bg-elevated); color: var(--text-secondary); }
.readme-card h2 { font-size: 16px; margin: 26px 0 12px; display: flex; align-items: center; gap: 8px; }
.readme-card p { font-size: 14px; line-height: 1.75; color: var(--text-secondary); }
.readme-list { margin-top: 4px; }
.readme-list li { font-size: 13.5px; line-height: 1.9; color: var(--text-secondary); display: flex; gap: 10px; }

/* 404 */
.notfound { text-align: center; padding: 90px 20px; }
.notfound__code { font-size: 90px; font-weight: 800; color: var(--pink); line-height: 1; }
.notfound__msg { color: var(--text-secondary); margin: 14px 0 28px; font-size: 15px; }

@media (max-width: 480px) {
  .stat-grid { grid-template-columns: 1fr 1fr; }
  .btn-row { flex-direction: column; }
  .btn { justify-content: center; }
}
